projection;
strict;
use draft;

define behavior for ZZAD6_C_SHIPMENT alias Shipment
use etag
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Items { create; with draft; }
}

define behavior for ZZAD6_C_SHIPMENT_ITEM alias ShipmentItem
use etag
{
  use update;
  use delete;

  use association _Shipment { with draft; }
}