*---------------------------------------------------------------------*
*    view related FORM routines
*---------------------------------------------------------------------*
*...processing: ZZAD6_V_MATERIAL................................*
FORM GET_DATA_ZZAD6_V_MATERIAL.
  PERFORM VIM_FILL_WHERETAB.
*.read data from database.............................................*
  REFRESH TOTAL.
  CLEAR   TOTAL.
  SELECT * FROM ZZAD6_D_MATERIAL WHERE
(VIM_WHERETAB) .
    CLEAR ZZAD6_V_MATERIAL .
ZZAD6_V_MATERIAL-MANDT =
ZZAD6_D_MATERIAL-MANDT .
ZZAD6_V_MATERIAL-MATERIAL_ID =
ZZAD6_D_MATERIAL-MATERIAL_ID .
ZZAD6_V_MATERIAL-UOM =
ZZAD6_D_MATERIAL-UOM .
    SELECT SINGLE * FROM ZZAD6_D_MAT_T WHERE
MATERIAL_ID = ZZAD6_D_MATERIAL-MATERIAL_ID AND
LANGU = SY-LANGU .
    IF SY-SUBRC EQ 0.
ZZAD6_V_MATERIAL-TITLE =
ZZAD6_D_MAT_T-TITLE .
ZZAD6_V_MATERIAL-DESCRIPTION =
ZZAD6_D_MAT_T-DESCRIPTION .
    ENDIF.
<VIM_TOTAL_STRUC> = ZZAD6_V_MATERIAL.
    APPEND TOTAL.
  ENDSELECT.
  SORT TOTAL BY <VIM_XTOTAL_KEY>.
  <STATUS>-ALR_SORTED = 'R'.
*.check dynamic selectoptions (not in DDIC)...........................*
  IF X_HEADER-SELECTION NE SPACE.
    PERFORM CHECK_DYNAMIC_SELECT_OPTIONS.
  ELSEIF X_HEADER-DELMDTFLAG NE SPACE.
    PERFORM BUILD_MAINKEY_TAB.
  ENDIF.
  REFRESH EXTRACT.
ENDFORM.
*---------------------------------------------------------------------*
FORM DB_UPD_ZZAD6_V_MATERIAL .
*.process data base updates/inserts/deletes.........................*
LOOP AT TOTAL.
  CHECK <ACTION> NE ORIGINAL.
MOVE <VIM_TOTAL_STRUC> TO ZZAD6_V_MATERIAL.
  IF <ACTION> = UPDATE_GELOESCHT.
    <ACTION> = GELOESCHT.
  ENDIF.
  CASE <ACTION>.
   WHEN NEUER_GELOESCHT.
IF STATUS_ZZAD6_V_MATERIAL-ST_DELETE EQ GELOESCHT.
     READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
     IF SY-SUBRC EQ 0.
       DELETE EXTRACT INDEX SY-TABIX.
     ENDIF.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN GELOESCHT.
  SELECT SINGLE FOR UPDATE * FROM ZZAD6_D_MATERIAL WHERE
  MATERIAL_ID = ZZAD6_V_MATERIAL-MATERIAL_ID .
    IF SY-SUBRC = 0.
    DELETE ZZAD6_D_MATERIAL .
    ENDIF.
    DELETE FROM ZZAD6_D_MAT_T WHERE
    MATERIAL_ID = ZZAD6_D_MATERIAL-MATERIAL_ID .
    IF STATUS-DELETE EQ GELOESCHT.
      READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY> BINARY SEARCH.
      DELETE EXTRACT INDEX SY-TABIX.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN OTHERS.
  SELECT SINGLE FOR UPDATE * FROM ZZAD6_D_MATERIAL WHERE
  MATERIAL_ID = ZZAD6_V_MATERIAL-MATERIAL_ID .
    IF SY-SUBRC <> 0.   "insert preprocessing: init WA
      CLEAR ZZAD6_D_MATERIAL.
    ENDIF.
ZZAD6_D_MATERIAL-MANDT =
ZZAD6_V_MATERIAL-MANDT .
ZZAD6_D_MATERIAL-MATERIAL_ID =
ZZAD6_V_MATERIAL-MATERIAL_ID .
ZZAD6_D_MATERIAL-UOM =
ZZAD6_V_MATERIAL-UOM .
    IF SY-SUBRC = 0.
    UPDATE ZZAD6_D_MATERIAL ##WARN_OK.
    ELSE.
    INSERT ZZAD6_D_MATERIAL .
    ENDIF.
    SELECT SINGLE FOR UPDATE * FROM ZZAD6_D_MAT_T WHERE
    MATERIAL_ID = ZZAD6_D_MATERIAL-MATERIAL_ID AND
    LANGU = SY-LANGU .
      IF SY-SUBRC <> 0.   "insert preprocessing: init WA
        CLEAR ZZAD6_D_MAT_T.
ZZAD6_D_MAT_T-MATERIAL_ID =
ZZAD6_D_MATERIAL-MATERIAL_ID .
ZZAD6_D_MAT_T-LANGU =
SY-LANGU .
      ENDIF.
ZZAD6_D_MAT_T-TITLE =
ZZAD6_V_MATERIAL-TITLE .
ZZAD6_D_MAT_T-DESCRIPTION =
ZZAD6_V_MATERIAL-DESCRIPTION .
    IF SY-SUBRC = 0.
    UPDATE ZZAD6_D_MAT_T ##WARN_OK.
    ELSE.
    INSERT ZZAD6_D_MAT_T .
    ENDIF.
    READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
    IF SY-SUBRC EQ 0.
      <XACT> = ORIGINAL.
      MODIFY EXTRACT INDEX SY-TABIX.
    ENDIF.
    <ACTION> = ORIGINAL.
    MODIFY TOTAL.
  ENDCASE.
ENDLOOP.
CLEAR: STATUS_ZZAD6_V_MATERIAL-UPD_FLAG,
STATUS_ZZAD6_V_MATERIAL-UPD_CHECKD.
MESSAGE S018(SV).
ENDFORM.
*---------------------------------------------------------------------*
FORM READ_SINGLE_ZZAD6_V_MATERIAL.
  SELECT SINGLE * FROM ZZAD6_D_MATERIAL WHERE
MATERIAL_ID = ZZAD6_V_MATERIAL-MATERIAL_ID .
ZZAD6_V_MATERIAL-MANDT =
ZZAD6_D_MATERIAL-MANDT .
ZZAD6_V_MATERIAL-MATERIAL_ID =
ZZAD6_D_MATERIAL-MATERIAL_ID .
ZZAD6_V_MATERIAL-UOM =
ZZAD6_D_MATERIAL-UOM .
    SELECT SINGLE * FROM ZZAD6_D_MAT_T WHERE
MATERIAL_ID = ZZAD6_D_MATERIAL-MATERIAL_ID AND
LANGU = SY-LANGU .
    IF SY-SUBRC EQ 0.
ZZAD6_V_MATERIAL-TITLE =
ZZAD6_D_MAT_T-TITLE .
ZZAD6_V_MATERIAL-DESCRIPTION =
ZZAD6_D_MAT_T-DESCRIPTION .
    ELSE.
      CLEAR SY-SUBRC.
      CLEAR ZZAD6_V_MATERIAL-TITLE .
      CLEAR ZZAD6_V_MATERIAL-DESCRIPTION .
    ENDIF.
ENDFORM.
*---------------------------------------------------------------------*
FORM CORR_MAINT_ZZAD6_V_MATERIAL USING VALUE(CM_ACTION) RC.
  DATA: RETCODE LIKE SY-SUBRC, COUNT TYPE I, TRSP_KEYLEN TYPE SYFLENG.
  FIELD-SYMBOLS: <TAB_KEY_X> TYPE X.
  CLEAR RC.
MOVE ZZAD6_V_MATERIAL-MATERIAL_ID TO
ZZAD6_D_MATERIAL-MATERIAL_ID .
MOVE ZZAD6_V_MATERIAL-MANDT TO
ZZAD6_D_MATERIAL-MANDT .
  CORR_KEYTAB             =  E071K.
  CORR_KEYTAB-OBJNAME     = 'ZZAD6_D_MATERIAL'.
  IF NOT <vim_corr_keyx> IS ASSIGNED.
    ASSIGN CORR_KEYTAB-TABKEY TO <vim_corr_keyx> CASTING.
  ENDIF.
  ASSIGN ZZAD6_D_MATERIAL TO <TAB_KEY_X> CASTING.
  PERFORM VIM_GET_TRSPKEYLEN
    USING 'ZZAD6_D_MATERIAL'
    CHANGING TRSP_KEYLEN.
  <VIM_CORR_KEYX>(TRSP_KEYLEN) = <TAB_KEY_X>(TRSP_KEYLEN).
  PERFORM UPDATE_CORR_KEYTAB USING CM_ACTION RETCODE.
  ADD: RETCODE TO RC, 1 TO COUNT.
  IF RC LT COUNT AND CM_ACTION NE PRUEFEN.
    CLEAR RC.
  ENDIF.

MOVE ZZAD6_D_MATERIAL-MATERIAL_ID TO
ZZAD6_D_MAT_T-MATERIAL_ID .
MOVE SY-LANGU TO
ZZAD6_D_MAT_T-LANGU .
MOVE ZZAD6_V_MATERIAL-MANDT TO
ZZAD6_D_MAT_T-MANDT .
  CORR_KEYTAB             =  E071K.
  CORR_KEYTAB-OBJNAME     = 'ZZAD6_D_MAT_T'.
  IF NOT <vim_corr_keyx> IS ASSIGNED.
    ASSIGN CORR_KEYTAB-TABKEY TO <vim_corr_keyx> CASTING.
  ENDIF.
  ASSIGN ZZAD6_D_MAT_T TO <TAB_KEY_X> CASTING.
  PERFORM VIM_GET_TRSPKEYLEN
    USING 'ZZAD6_D_MAT_T'
    CHANGING TRSP_KEYLEN.
  <VIM_CORR_KEYX>(TRSP_KEYLEN) = <TAB_KEY_X>(TRSP_KEYLEN).
  PERFORM UPDATE_CORR_KEYTAB USING CM_ACTION RETCODE.
  ADD: RETCODE TO RC, 1 TO COUNT.
  IF RC LT COUNT AND CM_ACTION NE PRUEFEN.
    CLEAR RC.
  ENDIF.

ENDFORM.
